{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "Goal block ledger — claims informativos (no lock)",
  "type": "object",
  "required": ["run", "workspaceRoot", "claims"],
  "properties": {
    "run": { "type": "string", "description": "slug del goal" },
    "workspaceRoot": { "type": "string", "description": "ruta absoluta worktree o proyecto" },
    "claims": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["agent", "subtask", "files", "status"],
        "properties": {
          "agent": { "type": "string" },
          "subtask": { "type": "string" },
          "files": { "type": "array", "items": { "type": "string" } },
          "status": { "enum": ["active", "done"] },
          "dependsOn": { "type": "array", "items": { "type": "string" }, "description": "subtasks previas requeridas; si cruzado → degrada secuencial (DAG)" }
        }
      }
    }
  }
}
